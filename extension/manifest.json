{
    "manifest_version":  3,
    "name":  "__MSG_extName__",
    "description":  "__MSG_extDesc__",
    "version":  "0.1.0",
    "key":  "",
    "minimum_chrome_version":  "120",
    "default_locale":  "en",
    "icons":  {
                  "16":  "icons/16.png",
                  "32":  "icons/32.png",
                  "48":  "icons/48.png",
                  "128":  "icons/128.png"
              },
    "action":  {
                   "default_popup":  "popup.html",
                   "default_title":  "__MSG_extName__",
                   "default_icon":  {
                                        "16":  "icons/16.png",
                                        "32":  "icons/32.png"
                                    }
               },
    "background":  {
                       "service_worker":  "background.js",
                       "type":  "module"
                   },
    "permissions":  [
                        "downloads",
                        "nativeMessaging",
                        "cookies",
                        "contextMenus",
                        "webRequest",
                        "storage",
                        "scripting"
                    ],
    "host_permissions":  [
                             "\u003call_urls\u003e"
                         ],
    "content_scripts":  [
                            {
                                "matches":  [
                                                "\u003call_urls\u003e"
                                            ],
                                "js":  [
                                           "content.js"
                                       ],
                                "run_at":  "document_idle",
                                "all_frames":  true,
                                "match_about_blank":  false
                            }
                        ]
}